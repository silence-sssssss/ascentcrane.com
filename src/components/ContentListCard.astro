---
import { Image } from 'astro:assets';
import { getMappedContentImage } from '../data/imageAssets';

interface Props {
  href: string;
  title: string;
  description: string;
  imagePath: string;
  viewLabel: string;
}

const { href, title, description, imagePath, viewLabel } = Astro.props;
---

<a
  href={href}
  class="group block h-full overflow-hidden rounded-[30px] border border-slate-200 bg-white text-slate-900 shadow-sm outline-none transition hover:-translate-y-1 hover:shadow-[0_24px_80px_rgba(15,39,68,0.14)] focus-visible:ring-2 focus-visible:ring-primary-600 focus-visible:ring-offset-2"
>
  <article class="flex h-full flex-col">
    <Image
      src={getMappedContentImage(imagePath)}
      alt={title}
      class="h-48 w-full shrink-0 object-cover"
      format="avif"
      quality="mid"
      widths={[400, 800, 1200]}
      sizes="(min-width: 1024px) 30vw, 100vw"
      width={1200}
      height={675}
      loading="lazy"
    />
    <div class="flex min-h-0 flex-1 flex-col p-7">
      <h2 class="line-clamp-2 text-xl font-bold leading-snug text-brand-navy">{title}</h2>
      <p class="mt-3 min-h-[5.25rem] text-sm leading-7 text-slate-600 line-clamp-3">{description}</p>
      <div class="mt-auto shrink-0 border-t border-slate-100 pt-5">
        <span
          class="flex w-full items-center justify-center rounded-full border border-primary-600/20 bg-primary-50 px-5 py-2.5 text-center text-sm font-semibold text-primary-800 transition group-hover:border-primary-600/40 group-hover:bg-primary-100"
        >
          {viewLabel}
        </span>
      </div>
    </div>
  </article>
</a>
